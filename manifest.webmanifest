{
  "name": "Finanças da Casa",
  "short_name": "Finanças",
  "description": "Controle das contas do casal: Pix, cartão, metas e quanto ainda dá para gastar",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2F5F3",
  "theme_color": "#0E6B5A",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "icone-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icone-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "comprovante",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".png",
            ".jpg",
            ".jpeg"
          ]
        }
      ]
    }
  }
}
